# --- Database (Postgres: Neon, Supabase or local) ---
# Owner role: runs migrations, auth tables, platform-admin queries. Owns the tables, so bypasses RLS.
# (The Vercel ↔ Neon integration sets DATABASE_URL and DATABASE_URL_UNPOOLED for you.)
DATABASE_URL=postgres://crm_owner:owner_pw@localhost:5432/crm
# App role: used for ALL tenant CRM data. Has no BYPASSRLS, so Postgres row-level security
# guarantees a request can only ever see rows of the tenant it is scoped to.
DATABASE_APP_URL=postgres://crm_app:app_pw@localhost:5432/crm
# Alternative for hosted Postgres: set only a password and `npm run db:migrate` creates the
# "crm_app" role and derives its URL from DATABASE_URL.
# APP_DB_PASSWORD=

# --- Platform ---
# Root domain of the platform. Tenants live at <slug>.<PLATFORM_DOMAIN>; the bare domain hosts
# the marketing page and the super-admin console (/admin).
PLATFORM_DOMAIN=localhost:3000
PLATFORM_NAME=Run the Town CRM
# Comma-separated emails that become super admins on seed / first login.
SUPER_ADMIN_EMAILS=drice@runthetown.co
# Where client custom domains should point (shown in DNS instructions).
CNAME_TARGET=cname.vercel-dns.com
# Optional: tenant to serve on hosts that match nothing (e.g. a *.vercel.app preview URL).
FALLBACK_TENANT_SLUG=

# --- Auth.js ---
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
AUTH_TRUST_HOST=true
# Optional Google OAuth. Each tenant host must be an authorized redirect URI:
#   https://<host>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (Resend) ---
# Leave empty in development: emails are written to the email log and shown at /dev/inbox.
RESEND_API_KEY=
# Default sender when a tenant has no verified sending domain.
EMAIL_FROM_ADDRESS=notifications@example.com

# --- Custom domains (optional): auto-add tenant domains to your Vercel project ---
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# --- Demo mode ---
# true = login pages show one-click sign-in for the seeded demo accounts (incl. a demo platform admin).
# Never enable this for a deployment that holds real client data.
DEMO_MODE=false
# Seeded demo tenants' domains, e.g. acme=acme-crm.vercel.app,harbor=harbor-crm.vercel.app
DEMO_DOMAINS=

# --- Cron ---
CRON_SECRET=change-me
